{
  "name": "autosdk-vscode",
  "displayName": "AutoSDK Script Tools",
  "description": "Edit, run, and build AutoSDK scripts for an iOS app installed via free Apple ID signing",
  "version": "0.14.0",
  "private": true,
  "publisher": "autosdk",
  "repository": {
    "type": "git",
    "url": "https://github.com/huihui0115/ios-auto-sdk.git"
  },
  "license": "UNLICENSED",
  "engines": {
    "vscode": ">=1.85.0"
  },
  "categories": [
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Connection inspection remains available, but running or deploying workspace scripts and starting local helpers requires trust.",
      "restrictedConfigurations": [
        "autosdk.iproxyPath",
        "autosdk.repositoryPath"
      ]
    }
  },
  "main": "extension.js",
  "activationEvents": [
    "onView:autosdk.devices",
    "onCommand:autosdk.runCurrentScript",
    "onCommand:autosdk.runSelection",
    "onCommand:autosdk.sendCurrentScript",
    "onCommand:autosdk.manageScripts",
    "onCommand:autosdk.configureDevice",
    "onCommand:autosdk.discoverDevice",
    "onCommand:autosdk.discoverUsbDevice",
    "onCommand:autosdk.startUsbTunnel",
    "onCommand:autosdk.stopUsbTunnel",
    "onCommand:autosdk.testConnection",
    "onCommand:autosdk.stopScript",
    "onCommand:autosdk.captureScreenshot",
    "onCommand:autosdk.inspectNodes",
    "onCommand:autosdk.openInspector",
    "onCommand:autosdk.buildIPA",
    "onLanguage:javascript",
    "onLanguage:typescript"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "autosdk",
          "title": "AutoSDK",
          "icon": "media/device-home.svg"
        }
      ]
    },
    "views": {
      "autosdk": [
        {
          "id": "autosdk.devices",
          "name": "设备与调试",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "autosdk.openDeviceHome",
        "title": "AutoSDK: 打开设备与调试",
        "icon": "$(device-mobile)"
      },
      {
        "command": "autosdk.newScript",
        "title": "AutoSDK: 新建示例脚本",
        "icon": "$(new-file)"
      },
      {
        "command": "autosdk.runSelection",
        "title": "AutoSDK: 只运行选中代码",
        "enablement": "editorHasSelection && !editorHasMultipleSelections && (editorLangId == javascript || editorLangId == typescript)"
      },
      {
        "command": "autosdk.runCurrentScript",
        "title": "AutoSDK: 运行整个脚本",
        "icon": "$(play)"
      },
      {
        "command": "autosdk.sendCurrentScript",
        "title": "AutoSDK: Send Current Script to Device"
      },
      {
        "command": "autosdk.manageScripts",
        "title": "AutoSDK: Manage Device Scripts"
      },
      {
        "command": "autosdk.configureDevice",
        "title": "AutoSDK: Configure Device Connection"
      },
      {
        "command": "autosdk.discoverDevice",
        "title": "AutoSDK: 搜索 Wi-Fi 手机",
        "icon": "$(device-mobile)"
      },
      {
        "command": "autosdk.discoverUsbDevice",
        "title": "AutoSDK: Search USB iPhone (Advanced)"
      },
      {
        "command": "autosdk.startUsbTunnel",
        "title": "AutoSDK: Start USB Tunnel"
      },
      {
        "command": "autosdk.stopUsbTunnel",
        "title": "AutoSDK: Stop USB Tunnel"
      },
      {
        "command": "autosdk.testConnection",
        "title": "AutoSDK: Test Device Connection"
      },
      {
        "command": "autosdk.stopScript",
        "title": "AutoSDK: 停止脚本"
      },
      {
        "command": "autosdk.captureScreenshot",
        "title": "AutoSDK: Capture Device Screenshot"
      },
      {
        "command": "autosdk.inspectNodes",
        "title": "AutoSDK: Inspect Device Nodes"
      },
      {
        "command": "autosdk.openInspector",
        "title": "AutoSDK: 截图与节点"
      },
      {
        "command": "autosdk.buildIPA",
        "title": "AutoSDK: Build IPA"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "autosdk.discoverDevice",
          "when": "view == autosdk.devices",
          "group": "navigation@1"
        },
        {
          "command": "autosdk.newScript",
          "when": "view == autosdk.devices",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "autosdk.runSelection",
          "when": "editorHasSelection && !editorHasMultipleSelections && (editorLangId == javascript || editorLangId == typescript)",
          "group": "navigation@9"
        },
        {
          "command": "autosdk.runCurrentScript",
          "when": "editorLangId == javascript || editorLangId == typescript",
          "group": "navigation@10"
        }
      ],
      "editor/title": [
        {
          "command": "autosdk.runCurrentScript",
          "when": "editorLangId == javascript || editorLangId == typescript",
          "group": "navigation@10"
        }
      ]
    },
    "configuration": {
      "title": "AutoSDK",
      "properties": {
        "autosdk.debugUrl": {
          "type": "string",
          "default": "",
          "description": "Wi-Fi or USB-forwarded WebSocket URL for the iPhone's AutoSDK debug server. Use Scan Wi-Fi and Add iPhone for normal setup."
        },
        "autosdk.connectionTimeout": {
          "type": "number",
          "default": 300000,
          "minimum": 1000,
          "maximum": 3600000,
          "description": "Milliseconds to wait for a debug command response."
        },
        "autosdk.inspectorMaxNodes": {
          "type": "number",
          "default": 1000,
          "minimum": 1,
          "maximum": 2000,
          "description": "Maximum nodes collected with each correlated Inspector screenshot snapshot."
        },
        "autosdk.inspectorActionRefreshDelay": {
          "type": "number",
          "default": 400,
          "minimum": 0,
          "maximum": 5000,
          "description": "Milliseconds to wait after a node action before capturing the refreshed Inspector snapshot."
        },
        "autosdk.iproxyPath": {
          "type": "string",
          "default": "iproxy",
          "description": "iproxy executable name or absolute path used by the managed USB tunnel."
        },
        "autosdk.usbDevicePort": {
          "type": "number",
          "default": 9001,
          "minimum": 1,
          "maximum": 65535,
          "description": "AutoSDK debug-server port on the iPhone forwarded by iproxy."
        },
        "autosdk.usbDeviceUdid": {
          "type": "string",
          "default": "",
          "description": "Optional iPhone UDID passed to iproxy when more than one device is connected."
        },
        "autosdk.wifiDeviceId": {
          "type": "string",
          "default": "",
          "description": "Bonjour identity of the Wi-Fi iPhone paired with this workspace."
        },
        "autosdk.iproxyUdidStyle": {
          "type": "string",
          "enum": [
            "modern",
            "legacy"
          ],
          "default": "modern",
          "description": "Use modern '-u UDID' arguments, or legacy trailing-UDID syntax for old iproxy builds."
        },
        "autosdk.repositoryPath": {
          "type": "string",
          "default": "",
          "description": "Local AutoSDK repository path used by the GitHub CLI build command."
        },
        "autosdk.repository": {
          "type": "string",
          "default": "",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "patternErrorMessage": "Use the GitHub owner/repository format.",
          "description": "GitHub owner/repository. Leave empty to detect it from the local Git checkout."
        },
        "autosdk.workflow": {
          "type": "string",
          "default": "Build AutoSDK IPA",
          "description": "GitHub Actions workflow used to build the AutoSDK IPA."
        },
        "autosdk.workflowRef": {
          "type": "string",
          "default": "",
          "description": "Optional branch or tag passed to the GitHub Actions workflow."
        },
        "autosdk.artifactName": {
          "type": "string",
          "default": "AutoSDKTemplate-ipa",
          "description": "GitHub Actions artifact containing the IPA."
        },
        "autosdk.buildTimeout": {
          "type": "number",
          "default": 1800,
          "minimum": 60,
          "maximum": 21600,
          "description": "Maximum number of seconds to wait for the remote IPA build."
        }
      }
    },
    "snippets": [
      {
        "language": "javascript",
        "path": "snippets/javascript.json"
      }
    ]
  },
  "scripts": {
    "precheck": "npm run check:home",
    "check": "node --check extension.js && node --check completion-model.js && node --check connection-recovery.js && node --check connection-settings.js && node --check device-client.js && node --check device-discovery.js && node --check wifi-discovery.js && node --check inspector-input.js && node --check inspector-service.js && node --check inspector-session.js && node --check process-lifecycle.js && node --check script-tools.js && node --check usb-tunnel.js && node --check inspector-view.js && node --check media/inspector-model.js && node --check media/inspector.js",
    "test": "node --test test/*.test.js",
    "check:home": "node --check device-home.js && node --check device-home-view.js && node --check media/device-home.js"
  },
  "dependencies": {
    "bonjour-service": "1.4.4",
    "typescript": "5.9.3",
    "ws": "^8.18.0"
  }
}
