{
  "name": "auto-sdk-tools",
  "version": "1.36.1",
  "private": true,
  "description": "Cross-platform helper for validating and invoking an iOS AutoSDK build",
  "bin": {
    "auto-sdk": "tools/auto-sdk.mjs"
  },
  "scripts": {
    "build": "node tools/auto-sdk.mjs build",
    "build:remote": "node tools/auto-sdk.mjs build-remote",
    "debug": "node tools/debug-client.mjs",
    "verify": "node tools/verify.mjs",
    "test": "node --test tools/*.test.mjs",
    "init": "node tools/init-project.mjs",
    "doctor": "node tools/doctor.mjs",
    "docs": "node tools/generate-devdocs.mjs",
    "regenerate:bootstrap": "node tools/regenerate-bootstrap.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
