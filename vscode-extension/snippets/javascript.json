{
  "AutoSDK script": {
    "prefix": "autosdk",
    "body": [
      "console.log('start');",
      "const node = auto.findElement({id: '${1:element-id}'});",
      "if (node && auto.exists(node)) {",
      "  auto.click(node);",
      "}",
      "auto.sleep(${2:300});"
    ],
    "description": "Run a basic AutoSDK node workflow"
  },
  "AutoSDK HTTP request": {
    "prefix": "autohttp",
    "body": [
      "const response = auto.http('${1:https://example.com/api}', {",
      "  method: '${2:GET}',",
      "  headers: {},",
      "  timeout: ${3:10000}",
      "});",
      "console.log(response.status, response.body);"
    ],
    "description": "Make a controlled AutoSDK HTTP request"
  },
  "AutoSDK node query": {
    "prefix": "autonode",
    "body": [
      "const nodes = auto.findElements({",
      "  labelMatch: '${1:.*}',",
      "  type: '${2:Button}',",
      "  visible: true,",
      "  maxResults: ${3:20}",
      "});",
      "for (const node of nodes) {",
      "  console.log(node.handle, node.text, node.bounds);",
      "}"
    ],
    "description": "Query stable node descriptors"
  },
  "AutoSDK image and color": {
    "prefix": "autocolor",
    "body": [
      "const point = auto.findMultiColor('${1:#ff3b30}', [",
      "  {dx: ${2:10}, dy: ${3:0}, color: '${4:#ffffff}'}",
      "], {x: 0, y: 0, width: ${5:390}, height: ${6:844}}, {tolerance: ${7:10}});",
      "if (point && point.found) auto.clickPoint(point.centerX, point.centerY);"
    ],
    "description": "Find a multi-point color pattern"
  },
  "AutoSDK sandbox storage": {
    "prefix": "autostore",
    "body": [
      "const store = storages.create('${1:settings}');",
      "store.putString('${2:key}', '${3:value}');",
      "file.writeFile('${4:data/output.txt}', store.getString('${2:key}'));"
    ],
    "description": "Use persistent storage and sandbox files"
  },
  "AutoSDK save media": {
    "prefix": "automedia",
    "body": [
      "// The source file must be inside the AutoSDK sandbox.",
      "media.saveImage('${1:images/output.png}');",
      "// media.saveVideo('${2:videos/output.mp4}');",
      "// media.saveScreenshot();"
    ],
    "description": "Save an image, video, or screenshot to the iOS photo library"
  },
  "AutoSDK region color search": {
    "prefix": "autofindcolorex",
    "body": [
      "const points = findColorEx('${1:0xCDD7E9-0x101010}', ${2:0.9}, ${3:0}, ${4:0}, ${5:0}, ${6:0}, ${7:10}, ${8:1});",
      "if (points && points.length > 0) clickPoint(points[0].x, points[0].y);"
    ],
    "description": "Find every matching color point in a region (EasyClick findColorEx)"
  },
  "AutoSDK region screenshot": {
    "prefix": "autoshotregion",
    "body": [
      "const png = screenshotRegion(${1:0}, ${2:0}, ${3:390}, ${4:60});",
      "if (png) file.writeBase64('captures/region.png', png);"
    ],
    "description": "Capture a rectangular region of the screen"
  },
  "AutoSDK audio playback": {
    "prefix": "automp3",
    "body": [
      "const ok = playMp3('${1:sounds/alert.mp3}', ${2:80}, ${3:false}, ${4:true});",
      "auto.sleep(${5:5000});",
      "stopMp3();"
    ],
    "description": "Play or stop an MP3 with the system audio player"
  },
  "AutoSDK photo authorization": {
    "prefix": "autophotoauth",
    "body": [
      "logd('status: ' + getPhotoAuthorizationStatus());",
      "const status = media.requestPhotoAuthorization();",
      "if (status === 'authorized' || status === 'limited') {",
      "  media.saveScreenshot();",
      "}"
    ],
    "description": "Check or request iOS photo library access"
  },
  "AutoSDK hashes": {
    "prefix": "autohash",
    "body": [
      "const digest = md5('${1:text}');",
      "const fileDigest = file.md5('${2:data/payload.json}');",
      "logd(digest, fileDigest);"
    ],
    "description": "Compute MD5/SHA1 for strings or sandbox files"
  },
  "AutoSDK image pipeline": {
    "prefix": "autoimage",
    "body": [
      "const clip = image.clip('${1:shots/s.png}', ${2:0}, ${3:0}, ${4:390}, ${5:60}, 'shots/head.png');",
      "const gray = image.gray('${1:shots/s.png}', 'shots/gray.png');",
      "const bw = image.binaryzation('${1:shots/s.png}', 'shots/bw.png', ${6:128});",
      "logd(clip, gray, bw);"
    ],
    "description": "Crop, grayscale or binarize an image file"
  },
  "AutoSDK zip archive": {
    "prefix": "autozip",
    "body": [
      "const zipPath = file.zip('${1:backup/scripts.zip}', ['${2:data/1.txt}', '${3:logs}']);",
      "logd('zip:', zipPath);",
      "const ok = file.unzip('${1:backup/scripts.zip}', 'backup/out');",
      "const text = file.readFileInZip('${1:backup/scripts.zip}', '${2:data/1.txt}');",
      "logd('unzip:', ok, 'entry:', text);"
    ],
    "description": "Create, extract or read entries from a ZIP archive"
  },
  "AutoSDK find not color": {
    "prefix": "autonotcolor",
    "body": [
      "const points = findNotColor('${1:0xFFFFFF-0x101010}', ${2:0.9}, ${3:0}, ${4:0}, ${5:0}, ${6:0}, ${7:10}, ${8:1});",
      "if (points && points.length > 0) logd('changed at', points[0].x, points[0].y);"
    ],
    "description": "Find points that do NOT match a color (change detection)"
  }
}
